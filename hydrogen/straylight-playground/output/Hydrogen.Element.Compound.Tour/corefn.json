{"builtWith":"0.15.15","comments":[{"LineComment":" ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"},{"LineComment":"                                              // hydrogen // element // tour"},{"LineComment":" ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"},{"LineComment":" | Tour — The ULTIMATE product tour component."},{"LineComment":" |"},{"LineComment":" | ## Overview"},{"LineComment":" |"},{"LineComment":" | A pure Element tour system with:"},{"LineComment":" | - 50+ message types for complete control"},{"LineComment":" | - Spring physics and morph animations"},{"LineComment":" | - Multi-target spotlight with shape morphing"},{"LineComment":" | - Branching paths with merge points"},{"LineComment":" | - Accessibility-first design (WCAG 2.1 AA)"},{"LineComment":" | - Reduced motion respect"},{"LineComment":" | - Persistence (localStorage/sessionStorage)"},{"LineComment":" | - Analytics events"},{"LineComment":" |"},{"LineComment":" | ## Quick Start"},{"LineComment":" |"},{"LineComment":" | ```purescript"},{"LineComment":" | import Hydrogen.Element.Compound.Tour as Tour"},{"LineComment":" |"},{"LineComment":" | myTour :: forall msg. (Tour.TourMsg -> msg) -> Tour.Element msg"},{"LineComment":" | myTour wrapMsg ="},{"LineComment":" |   Tour.tour"},{"LineComment":" |     [ Tour.steps"},{"LineComment":" |         [ Tour.step"},{"LineComment":" |             { id: Tour.stepId \"welcome\""},{"LineComment":" |             , target: Tour.noTarget"},{"LineComment":" |             , title: \"Welcome!\""},{"LineComment":" |             , content: \"Let's get you started.\""},{"LineComment":" |             }"},{"LineComment":" |         , Tour.step"},{"LineComment":" |             { id: Tour.stepId \"sidebar\""},{"LineComment":" |             , target: Tour.bySelector \".sidebar\""},{"LineComment":" |             , title: \"Navigation\""},{"LineComment":" |             , content: \"Use the sidebar to navigate.\""},{"LineComment":" |             }"},{"LineComment":" |         ]"},{"LineComment":" |     , Tour.onNext (wrapMsg Tour.NextStep)"},{"LineComment":" |     , Tour.onPrev (wrapMsg Tour.PrevStep)"},{"LineComment":" |     , Tour.onSkip (wrapMsg Tour.SkipTour)"},{"LineComment":" |     ]"},{"LineComment":" | ```"},{"LineComment":" |"},{"LineComment":" | ## Architecture"},{"LineComment":" |"},{"LineComment":" | Tours are pure data. The component produces `Element msg` which runtime"},{"LineComment":" | targets interpret. State changes flow through `TourMsg` messages."},{"LineComment":" |"},{"LineComment":" | ```"},{"LineComment":" | TourConfig → Element msg"},{"LineComment":" |     ↓"},{"LineComment":" | Runtime (DOM/Canvas/WebGL)"},{"LineComment":" |     ↓"},{"LineComment":" | User Interaction → TourMsg → State Update"},{"LineComment":" | ```"},{"LineComment":" |"},{"LineComment":" | ## Modules"},{"LineComment":" |"},{"LineComment":" | | Module           | Purpose                                |"},{"LineComment":" | |------------------|----------------------------------------|"},{"LineComment":" | | Tour.Types       | Core atoms (StepId, Placement, etc.)   |"},{"LineComment":" | | Tour.Target      | Target selection strategies            |"},{"LineComment":" | | Tour.Highlight   | Spotlight and overlay styles           |"},{"LineComment":" | | Tour.Animation   | Transitions, easing, spring physics    |"},{"LineComment":" | | Tour.Navigation  | Progress indicators and buttons        |"},{"LineComment":" | | Tour.Content     | Step content types                     |"},{"LineComment":" | | Tour.Msg         | Complete message algebra               |"},{"LineComment":" | | Tour.Motion      | Motion design presets                  |"},{"LineComment":" |"},{"LineComment":" | ## CSS Custom Properties"},{"LineComment":" |"},{"LineComment":" | ```css"},{"LineComment":" | /* Overlay */"},{"LineComment":" | --tour-overlay-color: rgba(0, 0, 0, 0.5);"},{"LineComment":" | --tour-overlay-blur: 0px;"},{"LineComment":" |"},{"LineComment":" | /* Tooltip */"},{"LineComment":" | --tour-tooltip-bg: var(--popover);"},{"LineComment":" | --tour-tooltip-fg: var(--popover-foreground);"},{"LineComment":" | --tour-tooltip-border: var(--border);"},{"LineComment":" | --tour-tooltip-shadow: 0 4px 12px rgba(0, 0, 0, 0.15);"},{"LineComment":" | --tour-tooltip-radius: 8px;"},{"LineComment":" | --tour-tooltip-max-width: 320px;"},{"LineComment":" |"},{"LineComment":" | /* Spotlight */"},{"LineComment":" | --tour-spotlight-padding: 4px;"},{"LineComment":" | --tour-spotlight-radius: 4px;"},{"LineComment":" |"},{"LineComment":" | /* Progress */"},{"LineComment":" | --tour-progress-color: var(--primary);"},{"LineComment":" | --tour-progress-bg: var(--muted);"},{"LineComment":" |"},{"LineComment":" | /* Animation */"},{"LineComment":" | --tour-duration: 300ms;"},{"LineComment":" | --tour-easing: cubic-bezier(0.22, 1.0, 0.36, 1.0);"},{"LineComment":" | ```"},{"LineComment":" |"},{"LineComment":" | ## Keyboard Shortcuts"},{"LineComment":" |"},{"LineComment":" | | Key       | Action          |"},{"LineComment":" | |-----------|-----------------|"},{"LineComment":" | | Escape    | Close tour      |"},{"LineComment":" | | ArrowRight| Next step       |"},{"LineComment":" | | ArrowLeft | Previous step   |"},{"LineComment":" | | Enter     | Confirm/Next    |"},{"LineComment":" | | Tab       | Focus trap      |"}],"decls":[{"annotation":{"meta":null,"sourceSpan":{"end":[0,0],"start":[0,0]}},"bindType":"NonRec","expression":{"abstraction":{"annotation":{"meta":{"metaType":"IsForeign"},"sourceSpan":{"end":[793,7],"start":[793,5]}},"type":"Var","value":{"identifier":"append","moduleName":["Data","Semigroup"]}},"annotation":{"meta":{"metaType":"IsSyntheticApp"},"sourceSpan":{"end":[798,12],"start":[792,3]}},"argument":{"annotation":{"meta":null,"sourceSpan":{"end":[0,0],"start":[0,0]}},"type":"Var","value":{"identifier":"semigroupString","moduleName":["Data","Semigroup"]}},"type":"Ap