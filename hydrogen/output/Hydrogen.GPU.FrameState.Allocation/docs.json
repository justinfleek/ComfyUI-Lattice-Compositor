ments":"Allocate rendering resources for a frame.\n\nAdapts allocation based on performance feedback:\n- If quality headroom is high (>0.7): use tier defaults\n- If quality headroom is medium (0.3-0.7): reduce background quality\n- If quality headroom is low (<0.3): reduce peripheral and background\n\nWill be enhanced with full submodular optimization in P2.\n","info":{"declType":"value","type":{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState"],"ViewportState"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState"],"PerformanceState"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState","Allocation"],"AllocationState"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState","Allocation"],"AllocationResult"],"tag":"TypeConstructor"}],"tag":"TypeApp"}],"tag":"TypeApp"}],"tag":"TypeApp"}},"kind":null,"sourceSpan":{"end":[368,90],"name":"src/Hydrogen/GPU/FrameState/Allocation.purs","start":[368,1]},"title":"allocateFrame"},{"children":[],"comments":"Result of allocating a frame.\n","info":{"arguments":[],"declType":"typeSynonym","type":{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Record"],"tag":"TypeConstructor"},{"annotation":[],"contents":["selections",{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Array"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","Render","Online","Core"],"RegionSelection"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":["nextState",{"annotation":[],"contents":[["Hydrogen","GPU","FrameState","Allocation"],"AllocationState"],"tag":"TypeConstructor"},{"annotation":[],"tag":"REmpty"}],"tag":"RCons"}],"tag":"RCons"}],"tag":"TypeApp"}},"kind":null,"sourceSpan":{"end":[358,4],"name":"src/Hydrogen/GPU/FrameState/Allocation.purs","start":[355,1]},"title":"AllocationResult"},{"children":[{"comments":null,"info":{"arguments":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Record"],"tag":"TypeConstructor"},{"annotation":[],"contents":["targetIterations",{"annotation":[],"contents":[["Prim"],"Int"],"tag":"TypeConstructor"},{"annotation":[],"contents":["maxRegions",{"annotation":[],"contents":[["Prim"],"Int"],"tag":"TypeConstructor"},{"annotation":[],"contents":["roundingCandidates",{"annotation":[],"contents":[["Prim"],"Int"],"tag":"TypeConstructor"},{"annotation":[],"contents":["qualityWeight",{"annotation":[],"contents":[["Prim"],"Number"],"tag":"TypeConstructor"},{"annotation":[],"contents":["coverageWeight",{"annotation":[],"contents":[["Prim"],"Number"],"tag":"TypeConstructor"},{"annotation":[],"contents":["seed",{"annotation":[],"contents":[["Prim"],"Number"],"tag":"TypeConstructor"},{"annotation":[],"tag":"REmpty"}],"tag":"RCons"}],"tag":"RCons"}],"tag":"RCons"}],"tag":"RCons"}],"tag":"RCons"}],"tag":"RCons"}],"tag":"TypeApp"}],"declType":"dataConstructor"},"sourceSpan":{"end":[529,4],"name":"src/Hydrogen/GPU/FrameState/Allocation.purs","start":[522,29]},"title":"FAAAllocationConfig"},{"comments":null,"info":{"declType":"instance","dependencies":[],"type":{"annotation":[],"contents":[{"annotation":[],"contents":[["Data","Eq"],"Eq"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState","Allocation"],"FAAAllocationConfig"],"tag":"TypeConstructor"}],"tag":"TypeApp"}},"sourceSpan":{"end":[531,64],"name":"src/Hydrogen/GPU/FrameState/Allocation.purs","start":[531,1]},"title":"eqFAAAllocationConfig"},{"comments":null,"info":{"declType":"instance","dependencies":[],"type":{"annotation":[],"contents":[{"annotation":[],"contents":[["Data","Show"],"Show"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState","Allocation"],"FAAAllocationConfig"],"tag":"TypeConstructor"}],"tag":"TypeApp"}},"sourceSpan":{"end":[536,38],"name":"src/Hydrogen/GPU/FrameState/Allocation.purs","start":[533,1]},"title":"showFAAAllocationConfig"}],"comments":"Configuration for FAA-enhanced allocation.\n\n## Theoretical Foundation\n\nUses FAA (Floquet Adiabatic Algorithm) for √T speedup over standard\ncontinuous greedy, then min-energy rounding for noise-resilient\ndiscretization.\n\n## Parameters\n\n- `targetIterations`: Controls precision (actual iterations = √targetIterations)\n- `maxRegions`: Maximum regions to select (cardinality constraint k)\n- `roundingCandidates`: Number of rounding candidates for min-energy selection\n- `qualityWeight`: Weight for quality-based utility\n- `coverageWeight`: Weight for spatial coverage utility\n\n## Proven Properties (FAA.lean, ContinuousGreedy.lean)\n\n- Achieves (1 - 1/e - O(1/√T)) approximation\n- In √T iterations instead of T\n- Min-energy rounding is deterministic and noise-resilient\n","info":{"dataDeclType":"newtype","declType":"data","roles":[],"typeArguments":[]},"kind":null,"sourceSpan":{"end":[529,4],"name":"src/Hydrogen/GPU/FrameState/Allocation.purs","start":[522,1]},"title":"FAAAllocationConfig"},{"children":[],"comments":"Create FAA allocation config with sensible defaults.\n\n## Real-Time Defaults (60fps target)\n\n- targetIterations: 100 → √100 = 10 actual iterations\n- roundingCandidates: 20 → fast min-energy selection\n- qualityWeight: 0.7 → prioritize render quality\n- coverageWeight: 0.3 → secondary coverage objective\n","info":{"declType":"value","type":{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Prim"],"Int"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Prim"],"Int"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState","Allocation"],"FAAAllocationConfig"],"tag":"TypeConstructor"}],"tag":"TypeApp"}],"tag":"TypeApp"}},"kind":null,"sourceSpan":{"end":[546,59],"name":"src/Hydrogen/GPU/FrameState/Allocation.purs","start":[546,1]},"title":"mkFAAAllocationConfig"},{"children":[],"comments":"Allocate frame using FAA-enhanced submodular optimization.\n\n## Algorithm\n\n1. Convert regions to ground set\n2. Create utility oracle (quality + coverage)\n3. Create cardinality matroid (k = maxRegions)\n4. Run FAA-enhanced continuous greedy (√T iterations)\n5. Round using min-energy selection (deterministic)\n6. Convert selected elements back to RegionSelections\n\n## Guarantees (Proven in proofs/Hydrogen/Optimize/Submodular/)\n\n- (1 - 1/e - O(1/√T)) approximation to optimal k-region selection\n- √T iterations instead of T (FAA speedup)\n- Deterministic rounding (min-energy)\n","info":{"declType":"value","type":{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState"],"ViewportState"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState"],"PerformanceState"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState","Allocation"],"AllocationState"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState","Allocation"],"FAAAllocationConfig"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState","Allocation"],"AllocationResult"],"tag":"TypeConstructor"}],"tag":"TypeApp"}],"tag":"TypeApp"}],"tag":"TypeApp"}],"tag":"TypeApp"}},"kind":null,"sourceSpan":{"end":[659,22],"name":"src/Hydrogen/GPU/FrameState/Allocation.purs","start":[654,1]},"title":"allocateFrameFAA"},{"children":[],"comments":"Convert regions to a ground set for submodular optimization.\n\nEach region becomes an Element indexed by position in the array.\nReturns (groundSet, indexToRegion) for mapping back after optimization.\n","info":{"declType":"value","type":{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Array"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","Render","Online","Core"],"Region"],"tag":"TypeConstructor"}],"tag":"TypeApp"}],"tag":"TypeApp"},{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Record"],"tag":"TypeConstructor"},{"annotation":[],"contents":["groundSet",{"annotation":[],"contents":[{"annotation":[],"contents":[["Hydrogen","Optimize","Submodular","Types"],"GroundSet"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState","Allocation"],"RegionIndex"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":["indexToRegion",{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Array"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","Render","Online","Core"],"Region"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"tag":"REmpty"}],"tag":"RCons"}],"tag":"RCons"}],"tag":"TypeApp"}],"tag":"TypeApp"}},"kind":null,"sourceSpan":{"end":[560,111],"name":"src/Hydrogen/GPU/FrameState/Allocation.purs","start":[560,1]},"title":"regionsToGroundSetFAA"},{"children":[],"comments":"Create a submodular oracle for region allocation.\n\n## Utility Function\n\nThe utility of selecting a set of regions S is:\n\n  f(S) = qualityWeight · Σ_{r ∈ S} tierQuality(r)\n       + coverageWeight · coverage(S)\n\nWhere:\n- tierQuality(r) = 1.0 for Foveal, 0.6 for Peripheral, 0.3 for Background\n- coverage(S) = √|S| (concave, encouraging spread)\n\n## Submodularity\n\nThe function is submodular because:\n- Linear sum is modular (trivially submodular)\n- √|S| is concave in |S| (submodular)\n- Non-negative sum of submodular functions is submodular\n","info":{"declType":"value","type":{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState","Allocation"],"FAAAllocationConfig"],"tag":"TypeConstructor"}],"tag":"TypeApp"},{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Array"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","Render","Online","Core"],"Region"],"tag":"TypeConstructor"}],"tag":"TypeApp"}],"tag":"TypeApp"},{"annotation":[],"contents":[{"annotation":[],"contents":[{"annotation":[],"contents":[["Prim"],"Function"],"tag":"TypeConstructor"},{"annotation":[],"contents":[{"annotation":[],"contents":[["Hydrogen","Optimize","Submodular","Types"],"GroundSet"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState","Allocation"],"RegionIndex"],"tag":"TypeConstructor"}],"tag":"TypeApp"}],"tag":"TypeApp"},{"annotation":[],"contents":[{"annotation":[],"contents":[["Hydrogen","Optimize","Submodular","Types"],"SubmodularOracle"],"tag":"TypeConstructor"},{"annotation":[],"contents":[["Hydrogen","GPU","FrameState","Allocation"],"RegionIndex"],"tag":"TypeConstructor"}],"tag":"TypeApp"}],"tag":"TypeApp"}],"tag":"TypeApp"}],"tag":"TypeApp"}},"kind":null,"sourceSpan":{"end":[590,34],"name":"src/Hydrogen/GPU/FrameState/Allocation.purs","start":[586,1]},"title":"regionUtilityOracle"},{"children":[],"comments":"Index type for mapping between Regions and submodular Elements.\n\nRegions are identified by position in the region array.\n","info":{"arguments":[],"declType":"typeSynonym","type":{"annotation":[],"contents":[["Prim"],"Int"],"tag":"TypeConstructor"}},"kind":null,"sourceSpan":{"end":[499,23],"name":"src/Hydrogen/GPU/FrameState/Allocation.purs","start":[499,1]},"title":"RegionIndex"}],"name":"Hydrogen.GPU.FrameState.Allocation","reExports":[]}